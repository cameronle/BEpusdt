# Optional USDT-only BSC / Polygon scanner. Public URLs only; no keys.
# Copy outside the repository, set permissions to 0600, and load via systemd
# EnvironmentFile. Keep keyed RPC URLs exclusively in that private copy.
BEPUSDT_EVM_SCANNER_V2=1
BEPUSDT_EVM_STATE_DIR=/var/lib/bepusdt/scanner-v2
BEPUSDT_RPC_BSC_URLS=https://bsc-rpc.publicnode.com,https://1rpc.io/bnb
BEPUSDT_RECEIPT_RPC_BSC_URLS=https://bsc-dataseed.bnbchain.org/,https://1rpc.io/bnb
BEPUSDT_RPC_POLYGON_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
BEPUSDT_RECEIPT_RPC_POLYGON_URLS=https://polygon.drpc.org,https://polygon-bor-rpc.publicnode.com
# Private keyed providers can be appended to these lists in your private file.
# Realtime/backfill pools are isolated but start from the same configured list.
# Last successful providers can remain preferred: fallback is not a quota cap.
# Enable native block confirmations before enabling scanner-v2.
# Runtime atom_usdt=0.0001 is a database/admin setting, not an env variable.
